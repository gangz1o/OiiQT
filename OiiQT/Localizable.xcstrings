    "Terms Section Acceptance Body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By downloading or using OiiQT, you agree to these Terms of Service. If you do not agree, please stop using the app."
          }
