    },
    "Terms Section LawfulUse Body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You must use OiiQT in compliance with applicable laws and regulations. You must not use the app for copyright infringement, unauthorized distribution, credential abuse, or any illegal activity."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您应在适用法律法规允许范围内使用 OiiQT，不得将本应用用于侵权下载、未经授权传播、凭据滥用或任何违法行为。"
          }
        }
      }
    },
