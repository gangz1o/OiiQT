    "Terms Section LiabilityLimit Body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To the maximum extent permitted by law, the developer shall not be liable for indirect, incidental, special, consequential, or punitive damages, including data loss, service interruption, or business losses caused by your use or inability to use the app."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在法律允许的最大范围内，开发者不对因您使用或无法使用本应用所导致的任何间接、附带、特殊、后果性或惩罚性损害承担责任，包括但不限于数据丢失、服务中断或经营损失。"
