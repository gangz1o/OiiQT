      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If your use violates applicable law or these terms, we may limit related feature availability in future versions or stop providing support, to the extent legally permitted."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
