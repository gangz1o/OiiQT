          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "8. 未成年人说明"
          }
        }
      }
    },
    "Policy Section Purpose Body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We process this information only for feature delivery, including: connecting to your configured downloader servers, displaying task and server status, applying your RSS automation rules, and rendering optional TMDB poster metadata when enabled by you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们仅为功能实现目的处理上述信息，包括：连接您配置的下载器服务器、展示任务与服务器状态、执行 RSS 自动化规则，以及在您开启时展示 TMDB 海报元数据。"
          }
        }
      }
    },
    "Policy Section Purpose Title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
