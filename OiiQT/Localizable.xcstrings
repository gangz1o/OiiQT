        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6. 保留与删除"
          }
        }
      }
    },
    "Policy Section SecurityNotice Body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OiiQT relies on iOS sandbox and system security capabilities to protect local data. If you enable options like \"Ignore SSL Certificate Errors\", connection security may be reduced. Please evaluate network trust settings carefully."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OiiQT 依赖 iOS 沙箱与系统安全能力保护本地数据。若您开启“忽略 SSL 证书错误”等选项，连接安全性可能下降，请谨慎评估网络信任设置。"
          }
        }
      }
    },
    "Policy Section SecurityNotice Title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
