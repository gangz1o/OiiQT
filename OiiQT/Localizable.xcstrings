        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "9. 适用法律"
          }
        }
      }
    },
    "Terms Section Indemnification Body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You agree to indemnify and hold harmless the app developer from claims, damages, and expenses arising from your unlawful use, rights infringement, or breach of these terms."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "因您违法使用、侵害他人权利或违反本条款而引发的索赔、损失及费用，您同意承担相应责任，并使开发者免受损害。"
          }
        }
      }
    },
