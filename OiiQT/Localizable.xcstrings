    "Policy Data Collection Body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OiiQT is a pure local client tool. We do not collect, upload, or share your server addresses, usernames, passwords, or any download task information. All sensitive information is stored encrypted locally on your device or within the iOS Keychain."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OiiQT 是一款纯粹的本地客户端工具。我们不收集、不上传、不共享您的服务器地址、用户名、密码或任何下载任务信息。所有敏感信息均加密存储在您设备的本地存储或 iOS 钥匙串（Keychain）中。"
          }
        }
      }
    },
    "Policy Data Collection Title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Data Collection & Use"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 数据收集与使用"
          }
        }
      }
    },
    "Policy Data Security Body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We utilize iOS system-level security features to protect your configurations. When you delete the application, all locally stored configuration information will be erased simultaneously."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们利用 iOS 的系统级安全特性保护您的配置。当您删除应用时，所有本地存储的相关配置信息将同步被抹除。"
          }
        }
      }
    },
    "Policy Data Security Title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. Data Security"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. 数据安全"
          }
        }
      }
    },
    "Policy Section Controls Body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can control data processing by editing or deleting server configurations, disabling TMDB features, disabling auto refresh, or clearing cached data in Settings. Because this app runs as a local client, there is no in-app account profile or cloud account center."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您可以通过编辑或删除服务器配置、关闭 TMDB 功能、关闭自动刷新、以及在设置中清理缓存来控制数据处理。由于本应用为本地客户端，不提供应用内账号体系或云端账户中心。"
          }
        }
      }
    },
