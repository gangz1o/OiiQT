    "Terms Section NoMonitoring Body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OiiQT is a local client tool and does not actively review, monitor, or verify the legality, authenticity, or completeness of server-side tasks, tracker content, or transmitted data under your control."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OiiQT 作为本地客户端工具，不对您控制范围内的服务器任务、Tracker 内容或传输数据进行主动审查、监控或合法性核验，也不对其真实性与完整性作出保证。"
          }
        }
      }
    },
