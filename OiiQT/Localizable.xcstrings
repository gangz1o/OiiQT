          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. 处理目的"
          }
        }
      }
    },
    "Policy Section Retention Body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data is retained on your device for as long as needed to support your use of the app, unless you delete it manually. You may remove server entries, clear caches, or delete the app at any time."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相关数据会在您的设备上保留，直至您手动删除或不再需要。您可以随时删除服务器配置、清理缓存或卸载应用。"
          }
        }
      }
    },
    "Policy Section Retention Title" : {
      "extractionState" : "stale",
      "localizations" : {
