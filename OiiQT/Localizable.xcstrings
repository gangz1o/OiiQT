    },
    "Terms Section Availability Body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app is provided on an \"as is\" and \"as available\" basis. We do not guarantee uninterrupted availability, compatibility with all server configurations, or error-free operation at all times."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本应用按“现状”与“可用”基础提供。我们不保证服务持续不中断、不保证兼容所有服务器配置，也不保证始终无错误运行。"
          }
        }
      }
    },
    "Terms Section Availability Title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5. Availability & Warranty Disclaimer"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5. 可用性与无担保声明"
          }
        }
      }
    },
    "Terms Section Compliance Body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You agree not to use OiiQT in restricted jurisdictions or for prohibited purposes under applicable laws, including sanctions, export controls, cybersecurity, and intellectual property regulations."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您承诺不在适用法律禁止的地区或用途下使用 OiiQT，并遵守包括制裁、出口管制、网络安全与知识产权在内的相关法律法规。"
          }
        }
      }
    },
    "Terms Section Compliance Title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "11. Compliance Commitment"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "11. 合规承诺"
          }
        }
      }
    },
    "Terms Section GoverningLaw Body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These terms shall be interpreted and enforced in accordance with applicable law. If any clause is held invalid, the remaining clauses shall remain in effect to the extent permitted by law."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本条款应依据适用法律进行解释与执行。如部分条款被认定无效，不影响其余条款在法律允许范围内继续有效。"
          }
        }
      }
    },
