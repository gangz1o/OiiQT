    "Policy Section Data Scope Body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OiiQT is a local client app. To provide downloader management features, the app may process the information you explicitly provide, including server address, port, username, password, RSS source URL, and task metadata (such as task name, status, tracker host, save path, and speed statistics)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OiiQT 是一款本地客户端应用。为实现下载器管理功能，应用会处理您主动提供的信息，包括服务器地址、端口、用户名、密码、RSS 源地址，以及任务相关元数据（如任务名称、状态、Tracker 域名、保存路径和速率统计）。"
          }
        }
      }
    },
    "Policy Section Data Scope Title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Data We Process"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 我们处理的数据"
          }
        }
      }
    },
    "Policy Section LocalStorage Body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configuration and cached data are stored locally on your device within app sandbox storage. OiiQT does not provide cloud sync for this data by default. Deleting the app will remove local app data according to iOS behavior."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "配置与缓存数据默认保存在您设备本地的应用沙箱中。OiiQT 默认不提供这类数据的云同步服务。删除应用后，本地应用数据将按 iOS 机制被移除。"
          }
        }
      }
    },
    "Policy Section LocalStorage Title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4. Local Storage"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4. 本地存储"
          }
        }
      }
    },
    "Policy Section Minors Body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OiiQT is not designed for children. If you are a minor, please use this app with guidance from a parent or legal guardian and ensure your use complies with applicable law."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OiiQT 不是面向未成年人的应用。如您属于未成年人，请在监护人指导下使用，并确保您的使用行为符合适用法律法规。"
          }
        }
      }
    },
    "Policy Section Minors Title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
