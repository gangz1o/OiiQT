          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5. 安全提示"
          }
        }
      }
    },
    "Policy Section ThirdParty Body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This app integrates third-party services such as TMDB (for poster/metadata retrieval) and Kingfisher (for image cache handling). When related features are enabled, necessary network requests may be sent to third-party endpoints, and those providers may process your public IP address under their own privacy terms."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本应用集成了 TMDB（用于海报与元数据检索）和 Kingfisher（用于图片缓存处理）等第三方服务。开启相关功能时，应用会向对应服务发起必要网络请求，服务提供方可能依据其隐私政策处理您的公网 IP 地址。"
          }
        }
      }
    },
    "Policy Section ThirdParty Title" : {
      "extractionState" : "stale",
      "localizations" : {
