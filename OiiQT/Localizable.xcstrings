    "Policy Third-Party Services Body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To provide a cinematic experience, this app integrates the following services:\n\n• TMDB: Used to retrieve movie posters and metadata.\n• Kingfisher: Used for local image caching and optimization.\n\nThese services may process your public IP address to deliver media assets according to their respective privacy policies."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为了提供丰富的影院级体验，本应用集成以下服务：\n\n• TMDB：用于获取影视海报及元数据。\n• Kingfisher：用于海报图片的本地缓存优化。\n\n这些服务可能会根据其自身的隐私政策处理您的公开 IP 地址以获取媒体资源。"
          }
        }
      }
    },
