    "Terms Section Availability Body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app is provided on an \"as is\" and \"as available\" basis. We do not guarantee uninterrupted availability, compatibility with all server configurations, or error-free operation at all times."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本应用按“现状”与“可用”基础提供。我们不保证服务持续不中断、不保证兼容所有服务器配置，也不保证始终无错误运行。"
          }
        }
      }
    },
