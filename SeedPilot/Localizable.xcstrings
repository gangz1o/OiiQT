    "Policy Data Collection Body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SeedPilot is a pure local client tool. We do not collect, upload, or share your server addresses, usernames, passwords, or any download task information. All sensitive information is stored encrypted locally on your device or within the iOS Keychain."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SeedPilot 是一款纯粹的本地客户端工具。我们不收集、不上传、不共享您的服务器地址、用户名、密码或任何下载任务信息。所有敏感信息均加密存储在您设备的本地存储或 iOS 钥匙串（Keychain）中。"
          }
        }
      }
    },
    "Policy Data Collection Title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Data Collection & Use"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 数据收集与使用"
          }
        }
      }
    },
    "Policy Data Security Body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We utilize iOS system-level security features to protect your configurations. When you delete the application, all locally stored configuration information will be erased simultaneously."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们利用 iOS 的系统级安全特性保护您的配置。当您删除应用时，所有本地存储的相关配置信息将同步被抹除。"
          }
        }
      }
    },
    "Policy Data Security Title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. Data Security"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. 数据安全"
          }
        }
      }
    },
    "Policy Section Controls Body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can control data processing by editing or deleting server configurations, disabling TMDB features, disabling auto refresh, or clearing cached data in Settings. Because this app runs as a local client, there is no in-app account profile or cloud account center."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您可以通过编辑或删除服务器配置、关闭 TMDB 功能、关闭自动刷新、以及在设置中清理缓存来控制数据处理。由于本应用为本地客户端，不提供应用内账号体系或云端账户中心。"
          }
        }
      }
    },
    "Policy Section Controls Title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7. User Controls"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7. 用户控制选项"
          }
        }
      }
    },
    "Policy Section Data Scope Body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SeedPilot is a local client app. To provide downloader management features, the app may process the information you explicitly provide, including server address, port, username, password, RSS source URL, and task metadata (such as task name, status, tracker host, save path, and speed statistics)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SeedPilot 是一款本地客户端应用。为实现下载器管理功能，应用会处理您主动提供的信息，包括服务器地址、端口、用户名、密码、RSS 源地址，以及任务相关元数据（如任务名称、状态、Tracker 域名、保存路径和速率统计）。"
          }
        }
      }
    },
    "Policy Section Data Scope Title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Data We Process"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 我们处理的数据"
          }
        }
      }
    },
    "Policy Section LocalStorage Body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configuration and cached data are stored locally on your device within app sandbox storage. SeedPilot does not provide cloud sync for this data by default. Deleting the app will remove local app data according to iOS behavior."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "配置与缓存数据默认保存在您设备本地的应用沙箱中。SeedPilot 默认不提供这类数据的云同步服务。删除应用后，本地应用数据将按 iOS 机制被移除。"
          }
        }
      }
    },
    "Policy Section LocalStorage Title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4. Local Storage"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4. 本地存储"
          }
        }
      }
    },
    "Policy Section Minors Body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SeedPilot is not designed for children. If you are a minor, please use this app with guidance from a parent or legal guardian and ensure your use complies with applicable law."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SeedPilot 不是面向未成年人的应用。如您属于未成年人，请在监护人指导下使用，并确保您的使用行为符合适用法律法规。"
          }
        }
      }
    },
    "Policy Section Minors Title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "8. Minors"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "8. 未成年人说明"
          }
        }
      }
    },
    "Policy Section Purpose Body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We process this information only for feature delivery, including: connecting to your configured downloader servers, displaying task and server status, applying your RSS automation rules, and rendering optional TMDB poster metadata when enabled by you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们仅为功能实现目的处理上述信息，包括：连接您配置的下载器服务器、展示任务与服务器状态、执行 RSS 自动化规则，以及在您开启时展示 TMDB 海报元数据。"
          }
        }
      }
    },
    "Policy Section Purpose Title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. Purpose of Processing"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. 处理目的"
          }
        }
      }
    },
    "Policy Section Retention Body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data is retained on your device for as long as needed to support your use of the app, unless you delete it manually. You may remove server entries, clear caches, or delete the app at any time."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相关数据会在您的设备上保留，直至您手动删除或不再需要。您可以随时删除服务器配置、清理缓存或卸载应用。"
          }
        }
      }
    },
    "Policy Section Retention Title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6. Retention & Deletion"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6. 保留与删除"
          }
        }
      }
    },
    "Policy Section SecurityNotice Body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SeedPilot relies on iOS sandbox and system security capabilities to protect local data. If you enable options like \"Ignore SSL Certificate Errors\", connection security may be reduced. Please evaluate network trust settings carefully."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SeedPilot 依赖 iOS 沙箱与系统安全能力保护本地数据。若您开启“忽略 SSL 证书错误”等选项，连接安全性可能下降，请谨慎评估网络信任设置。"
          }
        }
      }
    },
    "Policy Section SecurityNotice Title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5. Security Notice"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5. 安全提示"
          }
        }
      }
    },
    "Policy Section ThirdParty Body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This app integrates third-party services such as TMDB (for poster/metadata retrieval) and Kingfisher (for image cache handling). When related features are enabled, necessary network requests may be sent to third-party endpoints, and those providers may process your public IP address under their own privacy terms."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本应用集成了 TMDB（用于海报与元数据检索）和 Kingfisher（用于图片缓存处理）等第三方服务。开启相关功能时，应用会向对应服务发起必要网络请求，服务提供方可能依据其隐私政策处理您的公网 IP 地址。"
          }
        }
      }
    },
    "Policy Section ThirdParty Title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. Third-Party Services"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. 第三方服务"
          }
        }
      }
    },
    "Policy Section Updates Body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We may update this policy when features, legal requirements, or compliance obligations change. The latest version in the app shall prevail."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们可能因功能更新、法律法规要求或合规义务调整而更新本政策。以应用内展示的最新版本为准。"
          }
        }
      }
    },
