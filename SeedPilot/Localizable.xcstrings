    "Terms Section Compliance Body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You agree not to use SeedPilot in restricted jurisdictions or for prohibited purposes under applicable laws, including sanctions, export controls, cybersecurity, and intellectual property regulations."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您承诺不在适用法律禁止的地区或用途下使用 SeedPilot，并遵守包括制裁、出口管制、网络安全与知识产权在内的相关法律法规。"
          }
        }
      }
    },
